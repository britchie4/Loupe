// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Loupe
PRODUCT_DISPLAY_NAME = Loupe
PRODUCT_BUNDLE_IDENTIFIER = com.smughead.Loupe
MARKETING_VERSION = 1.2.1
CURRENT_PROJECT_VERSION = 7

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Merged into the generated Info.plist: Sparkle update feed and signing key
INFOPLIST_FILE = Config/Loupe-Info.plist

// ==========================================
// Linking
// ==========================================
// Embedded frameworks (Sparkle) load from the app's Frameworks folder
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// ==========================================
// Asset Catalog
// ==========================================
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Code Signing
// ==========================================
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = SDSL569695

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Loupe.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/Loupe.entitlements
